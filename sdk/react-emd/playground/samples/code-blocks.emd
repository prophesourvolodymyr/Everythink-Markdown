## [example|done] Python Code
```python
from typing import Optional
from dataclasses import dataclass

@dataclass
class User:
    id: str
    email: str
    name: str
    role: Optional[str] = "user"

    def is_admin(self) -> bool:
        return self.role == "admin"

def authenticate(token: str) -> Optional[User]:
    try:
        payload = jwt.decode(token, SECRET_KEY, algorithms=["HS256"])
        return User(**payload["user"])
    except jwt.InvalidTokenError:
        return None
```

## [example|done] JavaScript Code
```javascript
class EventEmitter {
  constructor() {
    this.listeners = new Map();
  }

  on(event, callback) {
    if (!this.listeners.has(event)) {
      this.listeners.set(event, []);
    }
    this.listeners.get(event).push(callback);
    return () => this.off(event, callback);
  }

  off(event, callback) {
    const cbs = this.listeners.get(event);
    if (cbs) {
      this.listeners.set(event, cbs.filter(cb => cb !== callback));
    }
  }

  emit(event, ...args) {
    const cbs = this.listeners.get(event);
    if (cbs) {
      cbs.forEach(cb => cb(...args));
    }
  }
}
```

## [example|done] TypeScript Code
```typescript
interface Result<T, E = Error> {
  ok: boolean;
  value?: T;
  error?: E;
}

function safeParse<T>(json: string): Result<T> {
  try {
    const value = JSON.parse(json) as T;
    return { ok: true, value };
  } catch (error) {
    return { ok: false, error: error as Error };
  }
}

type UserRole = 'admin' | 'user' | 'viewer';

function hasAccess(user: { role: UserRole }, requiredRole: UserRole): boolean {
  const ROLES: Record<UserRole, number> = { admin: 3, user: 2, viewer: 1 };
  return ROLES[user.role] >= ROLES[requiredRole];
}
```

## [example|done] Rust Code
```rust
use std::collections::HashMap;
use serde::{Deserialize, Serialize};

#[derive(Debug, Serialize, Deserialize)]
pub struct User {
    pub id: String,
    pub email: String,
    pub name: String,
    pub role: UserRole,
}

#[derive(Debug, Serialize, Deserialize)]
pub enum UserRole {
    Admin,
    User,
    Viewer,
}

impl User {
    pub fn is_admin(&self) -> bool {
        matches!(self.role, UserRole::Admin)
    }

    pub fn has_access(&self, required: &UserRole) -> bool {
        self.role >= *required
    }
}
```

## [example|done] Bash Script
```bash
#!/usr/bin/env bash
set -euo pipefail

DEPLOY_ENV="${1:-staging}"
TIMESTAMP=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

echo "[${TIMESTAMP}] Deploying to ${DEPLOY_ENV}..."

docker build -t "app:${DEPLOY_ENV}" .
docker push "app:${DEPLOY_ENV}"

kubectl set image "deployment/app-${DEPLOY_ENV}" \
  "app=app:${DEPLOY_ENV}"

kubectl rollout status "deployment/app-${DEPLOY_ENV}"

echo "[$(date -u +"%Y-%m-%dT%H:%M:%SZ")] Deploy complete!"
```

## [example|done] YAML Config
```yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: emd-api
  labels:
    app: emd
spec:
  replicas: 3
  selector:
    matchLabels:
      app: emd
  template:
    metadata:
      labels:
        app: emd
    spec:
      containers:
        - name: api
          image: everthink/emd-api:latest
          ports:
            - containerPort: 8080
          env:
            - name: DATABASE_URL
              valueFrom:
                secretKeyRef:
                  name: emd-secrets
                  key: database-url
```

